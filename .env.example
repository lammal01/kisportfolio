OPENAI_API_KEY=

# Fill in exactly ONE of the two sections below -- whichever is complete
# determines which KIS server the app talks to. No code change needed to
# switch: fill in KIS_PAPER_*, verify everything, then when ready for real
# trading, blank out KIS_PAPER_* and fill in KIS_REAL_* instead.
# Filling in BOTH sections at once is treated as a configuration error
# (fail-closed) rather than guessed.

# 모의투자 (paper trading) -- start here.
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_ACCOUNT_NO=

# 실전투자 (real trading) -- real money. Only fill this in once every phase
# up to the Phase roadmap's "장시간 Paper Trading" step has been validated.
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=
KIS_REAL_ACCOUNT_NO=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
