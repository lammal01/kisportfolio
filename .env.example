OPENAI_API_KEY=

# While PAPER_TRADING=true (the default), these must be your KIS
# 모의투자(paper trading) app key/secret/account -- NOT your real
# trading credentials. KIS issues separate keys per environment.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Fail-closed default: keep this true until live trading has been
# explicitly validated per the project's phase roadmap.
PAPER_TRADING=true
