# Claude API key from console.anthropic.com/settings/keys -- separate from
# any Claude Code subscription/login, needs its own billing/credits.
ANTHROPIC_API_KEY=
# Optional -- defaults to claude-opus-5 if unset.
ANTHROPIC_MODEL=

# Fill in exactly ONE of the two sections below -- whichever is complete
# determines which KIS server the app talks to. No code change needed to
# switch: fill in KIS_PAPER_*, verify everything, then when ready for real
# trading, blank out KIS_PAPER_* and fill in KIS_REAL_* instead.
# Filling in BOTH sections at once is treated as a configuration error
# (fail-closed) rather than guessed.

# Account number: either the 8-digit CANO alone (e.g. "12345678", product
# code defaults to "01", the standard stock account) or "12345678-01".

# 모의투자 (paper trading) -- start here.
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_ACCOUNT_NO=

# 실전투자 (real trading) -- real money. Only fill this in once every phase
# up to the Phase roadmap's "장시간 Paper Trading" step has been validated.
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=
KIS_REAL_ACCOUNT_NO=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# risk.risk_manager limits -- optional, default shown. Tune here, never in code.
# 1회 주문 최대 금액 = 계좌 총평가금액 * RISK_MAX_POSITION_PCT.
RISK_MAX_POSITION_PCT=0.10
# 당일 평가손실이 이 비율을 넘으면 그날 신규 BUY를 전면 차단 (SELL은 계속 허용).
RISK_DAILY_LOSS_LIMIT_PCT=0.03

# memory.trade_memory SQLite file -- optional, defaults to trade_memory.sqlite3
# in the project root. Each PC keeps its own (gitignored).
TRADE_DB_PATH=

# main.py --loop (Phase 11) -- optional, defaults shown.
# 감시 종목 (쉼표 구분): 삼성전자, SK하이닉스, 현대차, NAVER, LG에너지솔루션
WATCHLIST=005930,000660,005380,035420,373220
# 장중 사이클 간격(분)
CYCLE_MINUTES=10
# 하루 AI 호출 상한 -- 넘으면 그날은 AI를 부르지 않음
AI_DAILY_CALL_LIMIT=50
